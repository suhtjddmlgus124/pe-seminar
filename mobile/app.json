{
  "expo": {
    "name": "talkreminder",
    "slug": "mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/talkreminder-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/talkreminder-icon.png"
    },
    "android": {
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "package": "com.suh124.mobile"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/talkreminder-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#157A7E",
          "image": "./assets/images/talkreminder-icon.png",
          "imageWidth": 128
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9ed39d18-9b75-4f9a-96fb-e483dcfc9ca0"
      }
    }
  }
}
